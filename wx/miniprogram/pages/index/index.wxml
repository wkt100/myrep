<view class="container">
  <view class="header">
    <text class="title">今日执行系统</text>
  </view>

  <view class="task-list">
    <block wx:for="{{tasks}}" wx:key="_id">
      <view class="task-card {{item.status === 'done' ? 'done' : ''}} {{activeTaskId === item._id ? 'active' : ''}}">
        <view class="task-content">
          <text class="task-name">{{item.title}}</text>
          <text class="duration">累计专注: {{item.actualDuration || 0}}s</text>
        </view>
        
        <view class="timer-display" wx:if="{{activeTaskId === item._id}}">
          {{timerDisplay}}
        </view>

        <view class="card-actions">
          <block wx:if="{{item.status === 'done'}}">
            <view class="status-badge-done">已完成 ✓</view>
          </block>

          <block wx:else>
            <button 
              class="action-btn timer-btn {{timerRunning && activeTaskId === item._id ? 'stop' : ''}}"
              bindtap="toggleTimer" 
              data-id="{{item._id}}"
            >
              {{timerRunning && activeTaskId === item._id ? '停止计时' : '开始心流'}}
            </button>
            
            <button 
              class="action-btn done-btn"
              bindtap="markAsDone"
              data-id="{{item._id}}"
            >
              标记完成
            </button>
          </block>
        </view>
      </view>
    </block>
  </view>

  <view class="input-section" wx:if="{{tasks.length < 3}}">
    <input placeholder="设定最重要的事..." value="{{newTaskTitle}}" bindinput="onInput" />
    <button bindtap="addTask" class="add-btn">添加</button>
  </view>
</view>