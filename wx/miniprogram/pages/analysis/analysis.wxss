.container { padding: 40rpx; background: #f7f8fa; min-height: 100vh; }
.header { margin-bottom: 40rpx; }
.title { font-size: 40rpx; font-weight: bold; }

.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-bottom: 40rpx; }
.stat-card { background: #fff; padding: 30rpx; border-radius: 24rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; }
.stat-card.main { grid-column: span 2; background: #007aff; color: #fff; padding: 60rpx; }

.stat-label { font-size: 24rpx; opacity: 0.8; margin-bottom: 10rpx; }
.stat-value { font-size: 72rpx; font-weight: bold; font-family: 'Courier New', Courier, monospace; }
.stat-value-s { font-size: 48rpx; font-weight: bold; color: #333; }

.analysis-card { background: #fff; border-radius: 24rpx; padding: 40rpx; margin-bottom: 30rpx; }
.card-title { font-size: 30rpx; font-weight: bold; margin-bottom: 30rpx; color: #333; }
.insight-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.insight-label { color: #999; font-size: 28rpx; }
.insight-value { color: #e74c3c; font-weight: bold; font-size: 28rpx; }
.insight-tip { font-size: 22rpx; color: #aaa; margin-top: 30rpx; font-style: italic; }

/* 能量曲线样式 */
.mood-chart { margin-top: 20rpx; }
.chart-header { display: flex; justify-content: space-between; margin-bottom: 20rpx; padding: 0 10rpx; }
.chart-label { font-size: 24rpx; color: #999; }
.chart-scroll { width: 100%; white-space: nowrap; }
.chart-content { display: flex; align-items: flex-end; padding: 20rpx 10rpx; min-height: 300rpx; }
.mood-bar-container { display: flex; flex-direction: column; align-items: center; margin: 0 15rpx; min-width: 60rpx; }
.mood-bar-wrapper { height: 200rpx; width: 40rpx; background: #f5f5f5; border-radius: 8rpx; display: flex; align-items: flex-end; overflow: hidden; }
.mood-bar { width: 100%; border-radius: 8rpx; transition: height 0.3s ease; min-height: 10rpx; }
.mood-date { font-size: 20rpx; color: #999; margin-top: 10rpx; }
.mood-value { font-size: 22rpx; font-weight: bold; margin-top: 5rpx; }
.empty-tip { font-size: 24rpx; color: #ccc; margin: 100rpx auto; }

/* 时间块地图样式 */
.time-block-grid { display: flex; flex-direction: column; gap: 25rpx; margin-top: 20rpx; }
.time-block-item { display: flex; flex-direction: column; gap: 10rpx; }
.time-block-header { display: flex; justify-content: space-between; align-items: center; }
.time-block-label { font-size: 28rpx; color: #333; font-weight: 500; }
.time-block-count { font-size: 24rpx; color: #999; }
.time-block-bar { height: 24rpx; background: #f5f5f5; border-radius: 12rpx; overflow: hidden; }
.time-block-fill { height: 100%; border-radius: 12rpx; transition: width 0.3s ease; }
.time-block-percentage { font-size: 24rpx; color: #999; text-align: right; }
.best-time-tip { display: flex; align-items: center; margin-top: 30rpx; padding: 20rpx; background: #f0f9ff; border-radius: 16rpx; }
.best-time-label { font-size: 26rpx; color: #1890ff; font-weight: 500; }
.best-time-value { font-size: 26rpx; color: #1890ff; font-weight: bold; margin-left: 10rpx; }